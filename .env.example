APP_ENV=development
APP_NAME=Andromeda Ingestion Platform
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://andromeda:andromeda_local_only@postgres:5432/andromeda_ingestion
ARTIFACT_STORAGE_ROOT=./var/artifacts
FIXTURE_ROOT=./fixtures
KNOWLEDGE_CORE_URL=http://host.docker.internal:8001
KNOWLEDGE_CORE_ROLE=EDITOR
KNOWLEDGE_CORE_TOKEN=
API_DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:3000
AUTO_SEED=false
MOCK_AI_ENABLED=true
AI_PROVIDER=mock
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=configured-structured-extractor
AI_STRUCTURED_OUTPUT_MODE=json_object
MAX_REQUEST_BODY_BYTES=1048576
MAX_ARTIFACT_BYTES=30000000
FETCH_TIMEOUT_SECONDS=30
FETCH_TOTAL_BUDGET_SECONDS=90
FETCH_MAX_REDIRECTS=5
FETCH_RETRIES=2
MAX_DISCOVERY_ITEMS=200
MAX_PREPARED_CHUNKS=500
CONFIDENCE_REVIEW_THRESHOLD=0.8
JOB_MAX_ATTEMPTS=3
ENABLE_SECURITY_HEADERS=true
